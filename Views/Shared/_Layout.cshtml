
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Feedback Portal</title>

    <style>
        body {
            margin: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background: linear-gradient(145deg, #f8fafc 0%, #f1f5f9 50%, #e2e8f0 100%);
            background-attachment: fixed;
            color: #0f172a;
            -webkit-font-smoothing: antialiased;
            padding: 40px 24px;
        }

        /* Structural Split System (Breaks the standard centered container layout) */
        .container {
            max-width: 1200px;
            margin: 0 auto;
            background: transparent;
            border: none;
            box-shadow: none;
            display: flex;
            flex-direction: column;
            gap: 32px;
        }

        /* Top Branding bar - Floating stark pill style */
        h1 {
            margin: 0;
            font-size: 24px;
            font-weight: 800;
            letter-spacing: -0.03em;
            color: #090d16;
            background: rgba(255, 255, 255, 0.4);
            backdrop-filter: blur(30px) saturate(200%);
            -webkit-backdrop-filter: blur(30px) saturate(200%);
            border: 1px solid rgba(255, 255, 255, 0.7);
            padding: 16px 32px;
            border-radius: 100px; /* Absolute IOS Pill */
            display: inline-flex;
            align-self: center;
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.02);
        }

        hr {
            display: none; /* Removed structural horizontal lines entirely to rely on spacing */
        }

        /* Pixel Touch Pills: Flat structural buttons with zero border-radius curves */
        a, input[type=submit] {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #000000; /* Stark minimal monochrome */
            color: #ffffff;
            padding: 14px 28px;
            margin: 6px;
            border: 0;
            border-radius: 100px; /* Hyper curved pill edges */
            text-decoration: none;
            font: inherit;
            font-size: 13px;
            font-weight: 600;
            letter-spacing: 0.02em;
            cursor: pointer;
            transition: all 0.15s cubic-bezier(0.2, 0.8, 0.2, 1);
        }

            /* Pixel-Touch Active Response */
            a:hover, input[type=submit]:hover {
                background: #1a1a1a;
                transform: scale(1.03); /* Snap click simulation */
            }

            a:active, input[type=submit]:active {
                transform: scale(0.97);
            }

        /* Secondary Outlined pill with a pure glossy profile */
        .secondary {
            background: rgba(255, 255, 255, 0.5);
            color: #000000;
            border: 1px solid rgba(0, 0, 0, 0.1);
            backdrop-filter: blur(10px);
        }

            .secondary:hover {
                background: rgba(255, 255, 255, 0.9);
                color: #000000;
                border-color: rgba(0, 0, 0, 0.3);
            }

        /* Floating Glass Body Canvas (For main application workspace) */
        .form-card, .table-wrap, .student-banner {
            background: rgba(255, 255, 255, 0.25);
            backdrop-filter: blur(40px) saturate(220%);
            -webkit-backdrop-filter: blur(40px) saturate(220%);
            border: 1px solid rgba(255, 255, 255, 0.6);
            border-radius: 28px;
            padding: 32px;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.02), 0 12px 40px rgba(15, 23, 42, 0.04);
        }

        /* Student Profile layout transformation */
        .student-banner {
            border-radius: 100px; /* Entire module becomes an elongated iOS landscape capsule */
            padding: 14px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            text-align: left;
        }

            .student-banner h5 {
                margin: 0;
                font-size: 15px;
                font-weight: 700;
                color: #0f172a;
            }

            .student-banner p {
                font-size: 13px;
                color: #64748b;
            }

        .home-actions {
            text-align: center;
            margin: 10px 0;
        }

        /* Borderless Data Form Blocks */
        .form-table {
            width: 100%;
            border-spacing: 0 24px;
        }

            .form-table td {
                padding: 0;
                vertical-align: top;
            }

                .form-table td:first-child {
                    width: 25%;
                    padding-top: 14px;
                    font-size: 13px;
                    font-weight: 700;
                    text-transform: uppercase;
                    letter-spacing: 0.08em;
                    color: #475569;
                }

                .form-table td:last-child {
                    color: #dc2626;
                    font-size: 11px;
                    font-weight: 600;
                    padding-top: 8px;
                }

        /* Ultra-Clean Liquid Glass Fields */
        input[type=text], input[type=number], input[type=datetime],
        input[type=datetime-local], input[type=date], textarea, select {
            width: 100%;
            padding: 14px 24px;
            box-sizing: border-box;
            border: 1px solid rgba(0, 0, 0, 0.05);
            border-radius: 100px; /* Complete Pill Shaped fields */
            font: inherit;
            font-size: 14px;
            background: rgba(255, 255, 255, 0.4);
            color: #0f172a;
            transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        }

        textarea {
            border-radius: 20px; /* Soft corner restriction for multiline text fields */
            height: 120px;
        }

            /* Instant-focus snap without expanding outer rings */
            input:focus, textarea:focus, select:focus {
                outline: none;
                background: #ffffff;
                border-color: #000000;
                box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
            }

        /* Frameless Data Grid */
        .table-wrap {
            padding: 12px;
        }

        .feedback-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0 8px; /* Exploded row configuration */
        }

        th {
            background: transparent;
            color: #64748b;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            padding: 12px 20px;
        }

        .feedback-table td {
            background: rgba(255, 255, 255, 0.3);
            border: none;
            padding: 16px 20px;
            font-size: 14px;
            color: #334155;
            transition: background 0.15s ease;
        }

            /* Pill Shapes on Row Sides */
            .feedback-table td:first-child {
                border-radius: 16px 0 0 16px;
            }

            .feedback-table td:last-child {
                border-radius: 0 16px 16px 0;
            }

        /* Floating Rows Highlight */
        .feedback-table tr:hover td {
            background: rgba(255, 255, 255, 0.8);
            color: #000000;
        }

        .feedback-table tr:nth-child(even) td {
            background: rgba(255, 255, 255, 0.45);
        }

        /* Minimalist Canvas Footer */
        .footer {
            text-align: center;
            margin-top: 40px;
            color: #94a3b8;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            line-height: 1.8;
        }

            .footer strong {
                color: #475569;
                font-weight: 700;
            }


    </style>
</head>
<body>
    <div class="container">
        <h1>Feedback Management System</h1>
        <hr />

        @RenderBody()

        <hr />
        <div class="footer">
            <strong>Marwadi University</strong><br />
            Department of Computer Engineering
        </div>
    </div>
</body>
</html>
